{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "playwright.config.*",
    "eslint.config.*",
    "./packages/cli/**/*"
  ],
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite-ssg"]
  }
}
